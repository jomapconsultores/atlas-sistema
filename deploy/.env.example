# ============================================================
# Copia este archivo a  .env  y rellena los valores.
# NUNCA subas el .env real al repo (ya está cubierto por .gitignore).
# ============================================================

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_DB=atlas
# Contraseña del superusuario postgres (genera una larga y aleatoria)
POSTGRES_PASSWORD=CAMBIA_ESTO_postgres_pw
# Contraseña del rol 'authenticator' que usa PostgREST (otra distinta)
AUTHENTICATOR_PASSWORD=CAMBIA_ESTO_authenticator_pw

# --- PostgREST / JWT ---
# Secreto para firmar/validar los JWT (clave anon/service). MÍNIMO 32 caracteres.
# Con este secreto se generan las claves con: python deploy/gen_keys.py
JWT_SECRET=CAMBIA_ESTO_un_secreto_de_al_menos_32_caracteres

# --- Proxy / dominio ---
# Dominio para HTTPS automático (ej: db.tudominio.com). Si solo usarás IP, deja  :80
DOMAIN=:80

# --- Basic Auth para /adminer/* ---
# Adminer ya pide usuario/clave de Postgres, pero queda igual expuesto a
# internet (credential stuffing, CVEs de Adminer) sin esta capa extra.
ADMINER_AUTH_USER=admin
# Hash bcrypt de tu clave, NO la clave en texto plano. Generalo con:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'tu-clave-larga'
# y pega el resultado completo (empieza con $2a$ o $2b$) aca.
ADMINER_AUTH_HASH=CAMBIA_ESTO_pegar_hash_bcrypt_generado_arriba
