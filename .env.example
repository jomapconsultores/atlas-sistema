# Copia este archivo a ".env" y rellena tus valores reales. NO subas .env a git.
# Estas son las variables que lee la APP (app.py / config.py / supabase_client.py).
# Nota: la carpeta deploy/ (stack de BD auto-alojado) tiene su propio deploy/.env.example.

# --- Arranque obligatorio (la app NO levanta sin estas) ---
SECRET_KEY=                      # firma de sesiones (obligatoria, sin fallback). Ej: openssl rand -hex 32
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=                    # service_role (solo servidor)

# --- Servidor ---
PORT=5000
# Solo para desarrollo local por http: pon 1 para permitir cookies sin HTTPS.
FLASK_INSECURE_COOKIES=0

# --- Cron (recordatorio de cobros; ver .github/workflows/recordatorio-cobros.yml) ---
CRON_TOKEN=                      # debe coincidir con el header X-Cron-Token del workflow

# --- Email saliente (recordatorios) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BREVO_API_KEY=                   # alternativa/da servicio de envío vía Brevo

# --- Google Calendar (cuenta de servicio, JSON en una sola línea) ---
GOOGLE_SERVICE_ACCOUNT=

# --- Observabilidad (Sentry) — opcional; vacío = desactivado ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
